<Application x:Class="ChatClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChatClient"
             StartupUri="MVVM/View/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/MemberCard.xaml"/>
                <ResourceDictionary Source="/Themes/ConnectBox.xaml"/>
                <ResourceDictionary Source="/Themes/MessageBubble.xaml"/>
                <ResourceDictionary Source="/Themes/ImageButton.xaml"/>
                <ResourceDictionary Source="/Themes/StylishScrollbar.xaml"/>
                <ResourceDictionary Source="/Themes/MessageBoxAttachment.xaml"/>
                <ResourceDictionary Source="/Themes/MessageBubbleAttachment.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
