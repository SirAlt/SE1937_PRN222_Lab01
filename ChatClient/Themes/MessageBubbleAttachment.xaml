<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:ChatClient.MVVM.Core">

    <Style TargetType="ListViewItem" x:Key="MessageBubbleAttachment">

        <Style.Resources>
            <core:ByteUnitConverter x:Key="ByteUnitConverter"/>
        </Style.Resources>

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border Margin="0,4"
                            BorderThickness="2"
                            BorderBrush="#AA999999"
                            CornerRadius="6">
                        <Grid Margin="0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Image Width="50" Height="50"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   VerticalAlignment="Center"
                                   Source="/Icons/file_generic.png"/>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Stretch">
                                <Label Content="{Binding Filename}"
                                       Foreground="White"
                                       HorizontalAlignment="Left"/>
                                <Grid>
                                    <Label Content="{Binding SizeInBytes, Converter={StaticResource ByteUnitConverter}}"
                                           Foreground="#A2A2A2"
                                           HorizontalAlignment="Left"/>
                                    <Button Width="15" Height="15"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource ImageButton}"
                                            Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <Image Width="15" Height="15"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Source="/Icons/download.png"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsImage}" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>

                            <Image MaxWidth="400" MaxHeight="300"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   Margin="0,5">
                                <Image.Source>
                                    <Binding Path="ImageData">
                                        <Binding.TargetNullValue>
                                            <ImageSource>/Icons/file_image.png</ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>

    </Style>

</ResourceDictionary>