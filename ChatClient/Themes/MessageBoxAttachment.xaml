<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:ChatClient.MVVM.Model">

    <Style TargetType="ListViewItem" x:Key="MessageBoxAttachment">

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">

                    <Border Width="200" Height="200"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            BorderThickness="1"
                            Margin="8">

                        <Border.BorderBrush>
                            <SolidColorBrush Color="LightGray" Opacity="0.6"/>
                        </Border.BorderBrush>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <Button Width="15" Height="15"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ImageButton}"
                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}">
                                <Image Width="15" Height="15"
                                       Margin="0,2,2,0"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Source="/Icons/bin.png"/>
                            </Button>

                            <Image Grid.Row="1"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   Margin="0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="/Icons/file_generic.png"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                <Setter Property="Source">
                                                    <Setter.Value>
                                                        <Binding Path="ImageData">
                                                            <Binding.TargetNullValue>
                                                                <ImageSource>/Icons/file_image.png</ImageSource>
                                                            </Binding.TargetNullValue>
                                                        </Binding>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <Label Grid.Row="2"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   HorizontalContentAlignment="Left"
                                   VerticalContentAlignment="Bottom"
                                   FontSize="12"
                                   FontWeight="Medium">
                                <TextBlock Text="{Binding Filename}"
                                           TextTrimming="CharacterEllipsis" />
                            </Label>

                        </Grid>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>