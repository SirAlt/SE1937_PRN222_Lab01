<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:emoji="clr-namespace:iNKORE.UI.WPF.Emojis;assembly=iNKORE.UI.WPF.Emojis">

    <Style TargetType="ListViewItem" x:Key="MessageBubble">

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNativeOrigin}" Value="True">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Background" Value="#105C3B"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    Margin="0,8">

                                <emoji:EmojiedTextBlock Text="{Binding Message}"
                                                        Foreground="White"
                                                        Margin="6,0"
                                                        Padding="6"/>

                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>

        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="#202020"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Margin="8,4">

                        <StackPanel Margin="6,0">
                            <Label Content="{Binding Sender.Username}"
                                   Foreground="#A2A2A2"
                                   FontSize="11"/>
                            <emoji:EmojiedTextBlock Text="{Binding Message}"
                                                    Foreground="White"
                                                    Padding="6"/>
                            <Label Content="{Binding Time}"
                                   Foreground="#A2A2A2"
                                   FontSize="10"/>
                        </StackPanel>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>