<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatClient"
        xmlns:core="clr-namespace:ChatClient.MVVM.Core"
        xmlns:viewmodel="clr-namespace:ChatClient.MVVM.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="475" Width="815">

    <Window.Resources>
        <core:IPAddressConverter x:Key="IPAddressConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <viewmodel:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal"
                        Height="25"
                        Margin="0,5,0,0"
                        DockPanel.Dock="Top">
                <TextBox Height="25"
                         Width="140"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Right"
                         Text="{Binding IP, Mode=TwoWay, Converter={StaticResource IPAddressConverter}}"/>
                <TextBox Height="25"
                         Width="60"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Right"
                         Text="{Binding Port, Mode=TwoWay}"/>
            </StackPanel>
            <TextBox Height="25"
                     Margin="0,5"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     DockPanel.Dock="Top"
                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Height="25"
                    Margin="0,5"
                    DockPanel.Dock="Top"
                    Content="Connect"
                    Command="{Binding ConnectToServerCommand}"/>
            <Button Height="25"
                    DockPanel.Dock="Top"
                    Content="Disconnect"
                    Command="{Binding DisconnectCommand}"/>
            <ListView ItemsSource="{Binding Users}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Username}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <StackPanel Grid.Column="1">
            <ListView Height="380"
                      ItemsSource="{Binding Messages}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Path=Sender.Username}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Message}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal">
                <TextBox Height="55"
                         Width="490"
                         VerticalContentAlignment="Center"
                         Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Width="55" Content="Emoji"/>
                <Button Width="55" Content="Send" Command="{Binding SendChatCommand}"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
